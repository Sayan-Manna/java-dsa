{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current Java file clean",
      "type": "shell",
      "command": "javac \"${file}\" && java -cp \"${fileDirname}\" ${relativeFileDirname/\\//.}.${fileBasenameNoExtension}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
